{
  "fuzzy_threshold": 0.94,
  "fuzzy_margin": 0.05,
  "patterns": [
    {
      "pattern": "\\b(amazon\\.com|amazon mktpl|amazon prime)\\s*\\*\\s*[a-z0-9]+\\b",
      "replacement": "\\1"
    },
    {
      "pattern": "^a2 pci parking\\b.*$",
      "replacement": "a2 pci parking"
    },
    {
      "pattern": "^actblue\\s*\\*.*$",
      "replacement": "actblue"
    },
    {
      "pattern": "^panera bread\\b.*$",
      "replacement": "panera bread"
    },
    {
      "pattern": "^petsmart\\b.*$",
      "replacement": "petsmart"
    },
    {
      "pattern": "^rei\\b.*$",
      "replacement": "rei"
    },
    {
      "pattern": "^wholefds\\b.*$",
      "replacement": "whole foods"
    },
    {
      "pattern": "^target\\b.*$",
      "replacement": "target"
    },
    {
      "pattern": "^walmart\\b.*$",
      "replacement": "walmart"
    }
  ]
}
