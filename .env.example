# Local PostgreSQL credentials. Copy to .env and replace USER/PASS.
HOST=127.0.0.1
PORT=5432
USER=abacus
PASS=replace-with-your-local-password
DATABASE=abacus

# Optional full SQLAlchemy URL override (also accepted from the process environment).
# DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/abacus

# Ollama is deliberately loopback-only. Start Ollama separately.
OLLAMA_URL=http://127.0.0.1:11434
# Advisor generation/read timeout (30–1800 seconds); allow cold starts on local hardware.
ADVISOR_TIMEOUT_SECONDS=300

# Optional internet research for Budget advisor. Obtain your own Brave Search API key.
# Leave blank to keep web research unavailable; CSV imports and local chat still work.
BRAVE_SEARCH_API_KEY=
# Used to resolve relative dates such as "next fall".
APP_TIMEZONE=America/Detroit
