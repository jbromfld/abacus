# Local PostgreSQL credentials. Copy to .env and replace USER/PASS.
HOST=127.0.0.1
PORT=5432
USER=abacus
PASS=replace-with-your-local-password
DATABASE=abacus

# Optional full SQLAlchemy URL override (also accepted from the process environment).
# DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/abacus

# Dedicated advisor login for this same database; setup_advisor.py generates the password.
# Never reuse USER/PASS. Missing credentials disable advisor requests only.
ADVISOR_USER=abacus_advisor
ADVISOR_PASS=

# Ollama is deliberately loopback-only. Start Ollama separately.
OLLAMA_URL=http://127.0.0.1:11434
# Advisor generation/read timeout (30–1800 seconds); allow cold starts on local hardware.
ADVISOR_TIMEOUT_SECONDS=300
# Reply generation limit (256–4096 tokens). A limit stop is shown as an incomplete reply.
ADVISOR_MAX_TOKENS=768

# Optional internet research for Budget advisor. Obtain your own Brave Search API key.
# Leave blank to keep web research unavailable; CSV imports and local chat still work.
BRAVE_SEARCH_API_KEY=
# Used to resolve relative dates such as "next fall".
APP_TIMEZONE=America/Detroit

# Optional local Memora MCP service (feature defaults off in Settings).
# Use an absolute Python executable from the separate Babar environment.
# No shell command, URLs, cloud provider, or budget credentials are passed to it.
MEMORA_PYTHON=/absolute/path/to/babar/.venv/bin/python
MEMORA_CONFIG=/absolute/path/to/private/memora.json
MEMORA_TIMEOUT_SECONDS=30
